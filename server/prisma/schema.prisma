generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════

enum Role {
  PM
  BU_HEAD
  CFO
}

enum ProjectStatus {
  PROPOSAL
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum CostCategoryType {
  EMPLOYEE_SALARY
  SUBSCRIPTIONS
  TRAVEL
  ACCOMMODATION
  FOOD_ALLOWANCE
  GIFTS
  INFRASTRUCTURE
  CONTRACTOR
}

enum RagStatus {
  RED
  AMBER
  GREEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
  MATERIALIZED
}

enum ScopeCreepDecision {
  ABSORBED
  CHANGE_REQUEST
  DECLINED
}

// ═══════════════════════════════════════
// MODELS
// ═══════════════════════════════════════

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  email        String   @unique
  role         Role
  businessUnit String?  @map("business_unit")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managedProjects Project[]      @relation("ProjectManager")
  costEntries     CostEntry[]
  healthUpdates   HealthUpdate[]
  reviewNotes     ReviewNote[]

  @@map("users")
}

model Project {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  client        String
  contractValue Decimal       @db.Decimal(15, 2) @map("contract_value")
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  status        ProjectStatus @default(PROPOSAL)
  businessUnit  String        @map("business_unit")
  description   String?
  managerId     Int           @map("manager_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  manager           User               @relation("ProjectManager", fields: [managerId], references: [id])
  paymentMilestones PaymentMilestone[]
  allocations       ProjectAllocation[]
  costCategories    CostCategory[]
  costEntries       CostEntry[]
  healthUpdates     HealthUpdate[]
  risks             Risk[]
  scopeCreepEntries ScopeCreepEntry[]
  reviewNotes       ReviewNote[]

  @@map("projects")
}

model PaymentMilestone {
  id        Int       @id @default(autoincrement())
  projectId Int       @map("project_id")
  name      String
  amount    Decimal   @db.Decimal(15, 2)
  dueDate   DateTime  @map("due_date") @db.Date
  isPaid    Boolean   @default(false) @map("is_paid")
  paidDate  DateTime? @map("paid_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("payment_milestones")
}

model TeamMember {
  id             Int      @id @default(autoincrement())
  name           String
  role           String
  department     String
  loadedCostRate Decimal  @db.Decimal(15, 2) @map("loaded_cost_rate")
  skills         String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  allocations ProjectAllocation[]

  @@map("team_members")
}

model ProjectAllocation {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  teamMemberId    Int       @map("team_member_id")
  allocationPct   Decimal   @db.Decimal(5, 2) @map("allocation_pct")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  onboardingDate  DateTime? @map("onboarding_date") @db.Date
  offboardingDate DateTime? @map("offboarding_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])

  @@unique([projectId, teamMemberId, startDate])
  @@map("project_allocations")
}

model CostCategory {
  id           Int              @id @default(autoincrement())
  projectId    Int              @map("project_id")
  categoryType CostCategoryType @map("category_type")
  createdAt    DateTime         @default(now()) @map("created_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plannedAmounts PlannedAmount[]
  costEntries    CostEntry[]

  @@unique([projectId, categoryType])
  @@map("cost_categories")
}

model PlannedAmount {
  id             Int      @id @default(autoincrement())
  costCategoryId Int      @map("cost_category_id")
  period         String // Format: "YYYY-MM"
  amount         Decimal  @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  costCategory CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Cascade)

  @@unique([costCategoryId, period])
  @@map("planned_amounts")
}

model CostEntry {
  id             Int      @id @default(autoincrement())
  projectId      Int      @map("project_id")
  costCategoryId Int      @map("cost_category_id")
  period         String // Format: "YYYY-MM"
  actualAmount   Decimal  @db.Decimal(15, 2) @map("actual_amount")
  notes          String?
  enteredById    Int      @map("entered_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCategory CostCategory     @relation(fields: [costCategoryId], references: [id])
  enteredBy    User             @relation(fields: [enteredById], references: [id])
  auditLog     CostEntryAudit[]

  @@unique([costCategoryId, period])
  @@map("cost_entries")
}

model CostEntryAudit {
  id             Int      @id @default(autoincrement())
  costEntryId    Int      @map("cost_entry_id")
  previousAmount Decimal  @db.Decimal(15, 2) @map("previous_amount")
  newAmount      Decimal  @db.Decimal(15, 2) @map("new_amount")
  changedById    Int      @map("changed_by_id")
  changedAt      DateTime @default(now()) @map("changed_at")
  reason         String?

  costEntry CostEntry @relation(fields: [costEntryId], references: [id], onDelete: Cascade)

  @@map("cost_entry_audit")
}

model HealthUpdate {
  id                     Int       @id @default(autoincrement())
  projectId              Int       @map("project_id")
  period                 String // Format: "YYYY-MM"
  achievements           String[]  @default([])
  challenges             String[]  @default([])
  clientSatisfactionRag  RagStatus @map("client_satisfaction_rag")
  clientSatisfactionNote String?   @map("client_satisfaction_note")
  escalationCount        Int?      @map("escalation_count")
  changeRequestVolume    Int?      @map("change_request_volume")
  avgResponseTimeDays    Decimal?  @db.Decimal(5, 2) @map("avg_response_time_days")
  enteredById            Int       @map("entered_by_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enteredBy User    @relation(fields: [enteredById], references: [id])

  @@unique([projectId, period])
  @@map("health_updates")
}

model Risk {
  id             Int        @id @default(autoincrement())
  projectId      Int        @map("project_id")
  description    String
  probability    RiskLevel
  costImpact     Decimal    @db.Decimal(15, 2) @map("cost_impact")
  status         RiskStatus @default(OPEN)
  mitigationPlan String?    @map("mitigation_plan")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risks")
}

model ScopeCreepEntry {
  id          Int                @id @default(autoincrement())
  projectId   Int                @map("project_id")
  description String
  effortHours Decimal            @db.Decimal(8, 2) @map("effort_hours")
  costImpact  Decimal            @db.Decimal(15, 2) @map("cost_impact")
  decision    ScopeCreepDecision
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("scope_creep_entries")
}

model ReviewNote {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  period     String // Format: "YYYY-MM"
  note       String
  decision   String? // "Approved", "Needs Revision", "Acknowledged"
  reviewerId Int      @map("reviewer_id")
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@map("review_notes")
}
